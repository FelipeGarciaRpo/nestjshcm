PORT=3000
NODE_ENV=development

# SQLite database file path
DATABASE_PATH=./timeoff.sqlite

# Shared secret with HCM for HMAC webhook verification
# Must match HCM_WEBHOOK_SECRET in the hcm/ .env
WEBHOOK_SECRET=super-secret-hmac-key-change-in-prod

# Base URL of the HCM Mock server
HCM_BASE_URL=http://localhost:4000

# How often the outbox worker polls for pending events (milliseconds)
OUTBOX_POLL_INTERVAL_MS=5000

# Max retry attempts before marking an outbox event as FAILED
OUTBOX_MAX_RETRIES=5

# Max age of cache before forcing a re-sync from HCM (seconds)
BALANCE_CACHE_TTL_SECONDS=300

# Reject webhook events older than this (seconds) — replay attack prevention
WEBHOOK_MAX_AGE_SECONDS=300